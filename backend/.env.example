PORT=5000
MONGODB_URI=mongodb://localhost:27017/mini-employee-task-manager
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=1d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AES-256-GCM Encryption Key (must be exactly 64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AES_ENCRYPTION_KEY=

# SMTP Configuration for sending real OTP emails
# For Gmail: use an App Password (not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
# If SMTP credentials are not set, the system falls back to Ethereal test emails (not real delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Employee Task Manager" <noreply@employeemanager.com>
